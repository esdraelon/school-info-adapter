# School Information Adapter MCP — nginx SNIPPET (M5 deploy artifact).
# Merge into the haliffer.ululuth.com server block in
# /etc/nginx/sites-enabled/haliffer.ululuth.com.conf at deploy time,
# then: nginx -t && systemctl reload nginx.
# Mirrors the gateway's existing MCP blocks (todo/grades/datenight):
#   - TWO layers of auth: nginx `auth_request /_auth` checks the
#     gateway bearer token (haliffer-token), and the app ADDITIONALLY
#     enforces its own SCHOOL_MCP_TOKEN. Clients present BOTH, space-
#     separated, in one header: `Authorization: Bearer <gateway>,
#     Bearer <school>` — nginx forwards the header as-is, the auth
#     service and the app each pick out their own token.
#   - proxy_pass has NO URI part: the full /mcp/school/ path passes
#     through to the app (the app serves its MCP at /mcp/ and knows
#     nothing of the gateway prefix; uvicorn --proxy-headers plus the
#     pinned X-Forwarded-Proto make the app build external URLs as
#     https://haliffer.ululuth.com/mcp/school/...). A URI part here
#     would strip the prefix and the app would 307-redirect to an
#     internal URL.
#   - Host $http_host preserves the port, matching the sibling
#     blocks' DNS-rebinding note.
location /mcp/school/ {
    auth_request /_auth;
    proxy_pass http://127.0.0.1:8765;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Prefix /mcp/school;
    proxy_set_header Authorization $http_authorization;
    proxy_buffering off;
    proxy_read_timeout 300s;
}

# Companion app behavior: `school.app serve` runs uvicorn with
# proxy_headers=True + forwarded_allow_ips="*" (see cli.cmd_serve) —
# the app always trusts X-Forwarded-* when serving, so no compose
# command override is needed for the headers above to take effect.
